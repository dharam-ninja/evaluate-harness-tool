# Copy to .env and fill in. .env is gitignored; this file is not, so keep it free of
# real values.
#
# NOTE: the tool does NOT read .env itself -- there is no python-dotenv dependency and
# nothing auto-loads a file. Config expansion reads the PROCESS environment, so load the
# file into your shell first:
#
#   bash / macOS / Linux   set -a && . ./.env && set +a
#   PowerShell             Get-Content .env | % { if ($_ -match '^([^#=]+)=(.*)$') { [Environment]::SetEnvironmentVariable($Matches[1].Trim(), $Matches[2].Trim()) } }
#   cmd.exe                for /f "usebackq tokens=1,* delims==" %a in (".env") do set %a=%b
#
# Every variable below is referenced as ${NAME} or ${NAME:-default} in examples/*.yaml.
# A ${NAME} with no default and no value is a hard config error, by design: a
# half-configured run fails at validate time instead of silently using the wrong provider.


# --- Local model, used by eval-mixed.yaml, eval-html.yaml, eval-cleaner.yaml ----------
# Both have defaults, so you only set these to override. Ollama needs no credential.

LOCAL_MODEL=smollm2:360m
LOCAL_MODEL_URL=http://localhost:11434/v1


# --- Third-party OpenAI-compatible provider, used by eval-models.yaml -----------------
# HARNESS1_MODEL_URL has NO default. eval-models.yaml refuses to run until it is set.

HARNESS1_MODEL=llama-3.3-70b-instruct
HARNESS1_MODEL_URL=
HARNESS1_API_KEY=


# --- The Anthropic arm ----------------------------------------------------------------
# Not listed above on purpose. The documented path is `claude` interactive login, which
# stores an OAuth session and needs no variable here.
#
# If you must use an API key instead, set your own variable and reference it from the
# harness config as env: {ANTHROPIC_AUTH_TOKEN: "${MY_ANTHROPIC_KEY}"}.
#
# WARNING: a value reaching a harness `env:` block is expanded at config-load time and
# written verbatim into runs/<id>/manifest.json. Treat any run directory produced that
# way as secret, and do not commit it. Interactive login avoids this entirely.
#
# MY_ANTHROPIC_KEY=
